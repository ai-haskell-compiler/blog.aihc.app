+-- | Local benchmark trace: append one line to the file named by
+-- AIHC_TASK_TRACE, when the variable is set.
+traceTaskLine :: String -> IO ()
+traceTaskLine line = do
+  path <- lookupEnv "AIHC_TASK_TRACE"
+  case path of
+    Just file | not (null file) -> withMVar traceLock (\_ -> appendFile file (line <> "\n"))
+    _ -> pure ()
+
+traceLock :: MVar ()
+traceLock = unsafePerformIO (newMVar ())
+{-# NOINLINE traceLock #-}
+
+-- | Name a task in the trace.
+traceTaskLabel :: TaskId -> String -> IO ()
+traceTaskLabel (TaskId n) label = traceTaskLine (unwords ["N", show n, label])
