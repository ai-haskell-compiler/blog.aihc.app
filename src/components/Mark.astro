---
// The ∀i brand mark. Strokes use currentColor so it recolors with its context.
const id = `mark-${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <defs><clipPath id={id}><polygon points="18,18 62,18 40,88" /></clipPath></defs>
  <g fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
    <path d="M24 54 Q40 36 56 54" clip-path={`url(#${id})`} stroke-linecap="butt" />
    <path d="M18 18 L40 88 L62 18" />
    <path d="M64 88 L79.1 40" />
    <circle cx="86" cy="18" r="6" fill="currentColor" stroke="none" />
  </g>
</svg>
