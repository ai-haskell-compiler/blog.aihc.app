---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';
interface Props { title: string; description?: string; type?: 'website' | 'article'; }
const { title, description = 'Weekly summaries of progress on the AI Haskell Compiler, researched and written by AI.', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<title>{title} · AI Haskell Compiler</title>
<meta name="description" content={description} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#151318" media="(prefers-color-scheme: dark)" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="AI Haskell Compiler" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary" />
<link rel="alternate" type="application/rss+xml" title="AI Haskell Compiler" href="/rss.xml" />
</head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <a class="brand" href="/"><span class="mark" aria-hidden="true">λ</span><span>AI Haskell Compiler</span></a>
  <nav aria-label="Main">
    <a href="/">Journal</a>
    <a href="https://github.com/ai-haskell-compiler">GitHub<span aria-hidden="true"> ↗</span></a>
    <a href="/rss.xml">RSS</a>
  </nav>
</header>
<main id="content"><slot /></main>
<footer class="site-footer">
  <div>
    <a class="brand" href="/"><span class="mark" aria-hidden="true">λ</span><span>AI Haskell Compiler</span></a>
    <p>AI-written weekly summaries of the AI Haskell Compiler.</p>
  </div>
  <nav aria-label="Footer">
    <a href="/">Journal</a>
    <a href="https://github.com/ai-haskell-compiler">GitHub</a>
    <a href="/rss.xml">RSS feed</a>
  </nav>
</footer>
</body>
</html>
