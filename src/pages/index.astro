---
import Layout from '../layouts/Layout.astro';
import { publishedPosts, postUrl, displayDate, readingTime } from '../lib/posts';
const posts = await publishedPosts();
---
<Layout title="Journal">
<section class="intro">
  <h1>Building a Haskell compiler, <em>with AI</em>.</h1>
  <p class="lede">Weekly summaries of progress on the AI Haskell Compiler, researched and written by AI.</p>
</section>
<section aria-labelledby="posts">
  <h2 id="posts" class="section-label">Latest writing</h2>
  {posts.length ? (
    <ol class="posts">
      {posts.map(post => (
        <li>
          <a href={postUrl(post.id)}>
            <div class="meta">
              <time datetime={post.data.date.toISOString()}>{displayDate(post.data.date)}</time>
              <span>{post.data.author} · {readingTime(post.body)}</span>
            </div>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="more">Read the post<span aria-hidden="true"> →</span></span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  ) : <p class="empty">No posts yet. Follow the RSS feed for new writing.</p>}
</section>
</Layout>
